#!/bin/bash
set -euo pipefail

if [[ $# != 1 && $# != 3 ]]; then
  echo "Usage: check-homebrew OWNER/TAP [BASE HEAD] (run in the tap directory)" >&2
  exit 2
fi

tap="$1"
if [[ ! "$tap" =~ ^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Expected a lowercase OWNER/TAP namespace" >&2
  exit 2
fi

export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_FROM_API=1 HOMEBREW_NO_ANALYTICS=1
shopt -s nullglob
formulae=(Formula/*.rb)
if [[ ${#formulae[@]} == 0 ]]; then
  echo "::notice::No Formula/*.rb files to validate."
  exit 0
fi

changed_formulae=''
if [[ $# == 3 ]]; then
  base="$(git rev-parse --verify --end-of-options "$2^{commit}")"
  head="$(git rev-parse --verify --end-of-options "$3^{commit}")"
  changed_formulae="$(git diff --relative --name-only --no-renames --diff-filter=ACMRT "$base...$head" -- 'Formula/*.rb')"
fi

tap_directory="$(brew --repository)/Library/Taps/${tap%/*}/homebrew-${tap#*/}"
if [[ -e "$tap_directory" || -L "$tap_directory" ]]; then
  echo "Tap already exists: $tap" >&2
  exit 1
fi
mkdir -p "$(dirname "$tap_directory")"
ln -s "$PWD" "$tap_directory"
trap 'rm -- "$tap_directory"' EXIT

for formula in "${formulae[@]}"; do
  name="${formula##*/}"
  reference="$tap/${name%.rb}"
  brew style "$reference"
  brew audit --strict "$reference"
done

while IFS= read -r formula; do
  [[ -n "$formula" && -f "$formula" ]] || continue
  name="${formula##*/}"
  reference="$tap/${name%.rb}"
  brew install --build-from-source "$reference"
  brew test "$reference"
done <<< "$changed_formulae"
